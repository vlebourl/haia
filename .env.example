# HAIA Configuration Template
# Copy this file to .env and fill in your actual values

# Anthropic API Configuration
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Google Gemini API Configuration (Future: LiteLLM proxy integration)
# Not yet used - reserved for future multi-provider support via LiteLLM
GEMINI_API_KEY=your-gemini-api-key-here

# Model Configuration
# Options: anthropic:claude-haiku-4-5-20251001, anthropic:claude-sonnet-4-5-20250929, ollama:qwen2.5-coder
HAIA_MODEL=anthropic:claude-haiku-4-5-20251001

# System Prompt Configuration (REQUIRED - copy from your .env file)
# This defines Haia's personality, behavior, and capabilities.
# Copy the full HAIA_SYSTEM_PROMPT from your actual .env file here.
# The comprehensive prompt should be a multi-line string covering:
# - Who Haia is (personality, communication style)
# - Technical expertise areas
# - Safety protocols and operational guidelines
# - Example interactions
#
# If not set, falls back to a minimal default prompt (not recommended for production).
# See your .env file for the full prompt - do not commit your personalized version here.
HAIA_SYSTEM_PROMPT="[Copy your comprehensive system prompt from .env here]"

# Homelab Profile Configuration (OPTIONAL)
# Path to your personal homelab profile YAML file
# Default: haia_profile.yaml (automatically gitignored)
HAIA_PROFILE_PATH=haia_profile.yaml

# Conversation Settings
# Number of messages to keep in conversation context
# Claude Haiku 4.5 (200k tokens): Recommended 100 messages (~50k tokens, 25% utilization)
# Claude Sonnet 4.5 (200k tokens): Recommended 100 messages
# Ollama models: Adjust based on model's context window (typically 4k-32k tokens)
CONTEXT_WINDOW_SIZE=100

# Database Configuration (Conversation history - Session 2)
DATABASE_URL=sqlite+aiosqlite:///./haia.db

# Neo4j Memory Database Configuration (Session 3)
# Connection URI - use 'neo4j' hostname for Docker, 'localhost' for local development
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_secure_neo4j_password_here

# Memory Extraction Configuration (Session 7)
# Model for memory extraction - defaults to HAIA_MODEL if not specified
# Using a lighter model (like Haiku) for extraction is cost-effective
EXTRACTION_MODEL=
# Minimum confidence threshold for extracted memories (0.0-1.0)
# Default: 0.4 (selective/aggressive strategy)
EXTRACTION_MIN_CONFIDENCE=0.4

# Embedding Configuration (Session 8 - Memory Retrieval)
# Embedding model for semantic search - using Ollama for privacy and consistency
# Options: ollama:nomic-embed-text (768-dim, 62% MTEB, recommended), ollama:mxbai-embed-large (1024-dim, 65% MTEB)
EMBEDDING_MODEL=ollama:nomic-embed-text
EMBEDDING_DIM=768
# Ollama API base URL - use 'http://ollama:11434' for Docker, 'http://localhost:11434' for local
OLLAMA_BASE_URL=http://localhost:11434

# Retrieval Configuration (Session 8 - Memory Retrieval)
# Number of memories to retrieve in semantic search
RETRIEVAL_TOP_K=10
# Minimum cosine similarity threshold (0.0-1.0) - higher = stricter matching
RETRIEVAL_MIN_SIMILARITY=0.65
# Minimum confidence threshold (0.0-1.0) for retrieved memories
RETRIEVAL_MIN_CONFIDENCE=0.4

# Memory Type Weights (Session 8 - User Story 3: Relevance Filtering)
# Multipliers for relevance scoring by memory type (0.0-10.0)
# Higher values prioritize that memory type in retrieval results
MEMORY_TYPE_WEIGHT_PREFERENCE=1.2
MEMORY_TYPE_WEIGHT_TECHNICAL_CONTEXT=1.1
MEMORY_TYPE_WEIGHT_DECISION=1.0
MEMORY_TYPE_WEIGHT_PERSONAL_FACT=0.9
MEMORY_TYPE_WEIGHT_CORRECTION=1.3

# Context Optimization Configuration (Session 9)
# Enable/disable context optimization features for memory retrieval
CONTEXT_ENABLE_DEDUPLICATION=true
CONTEXT_ENABLE_RERANKING=true
CONTEXT_ENABLE_BUDGETING=false
CONTEXT_TRACK_ACCESS=true

# Deduplication settings
CONTEXT_DEDUP_SIMILARITY_THRESHOLD=0.92

# Re-ranking weights (must sum to ~1.0)
CONTEXT_RERANK_WEIGHT_SIMILARITY=0.40
CONTEXT_RERANK_WEIGHT_CONFIDENCE=0.25
CONTEXT_RERANK_WEIGHT_RECENCY=0.20
CONTEXT_RERANK_WEIGHT_FREQUENCY=0.15

# Token budget settings (cost control)
CONTEXT_TOKEN_BUDGET=2000
CONTEXT_TOKEN_BUFFER=50
CONTEXT_TRUNCATION_STRATEGY=HARD_CUTOFF

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Data Storage (Portable)
# All persistent data stored here for easy backup/migration
# Default: ../data (relative to deployment/docker-compose.yml)
# For custom location: /path/to/your/haia-data
DATA_DIR=../data

# OpenWebUI Configuration
WEBUI_PORT=3000  # Web interface port
WEBUI_ENABLE_SIGNUP=true  # Allow new user registration
WEBUI_DEFAULT_USER_ROLE=user  # Default role for new users (user|admin)

# =============================================================================
# SESSION 10: HYBRID TEMPORAL MEMORY SYSTEM
# =============================================================================

# Phase 1: Temporal Tracking & BM25 Search
BM25_SEARCH_ENABLED=true
BM25_MIN_SCORE=0.1
TEMPORAL_QUERIES_ENABLED=true
DEFAULT_TEMPORAL_QUERY_MODE=current  # "current" | "at_time" | "all"

# Phase 2: Dynamic Entity Types
MIN_DYNAMIC_TYPE_CONFIDENCE=0.6
LOG_EXTRACTION_TYPES=true

# Phase 5: Semantic Type Clustering (User Story 3)
# Automatically cluster semantically similar memory types to prevent vocabulary explosion
TYPE_CLUSTERING_ENABLED=true
TYPE_CLUSTERING_MIN_SIZE=3  # Minimum types per cluster
TYPE_CLUSTERING_SIMILARITY_THRESHOLD=0.80  # Cosine similarity threshold (0.0-1.0)
TYPE_CLUSTERING_SCHEDULE=0 4 * * *  # Cron: Daily at 4 AM

# Embedding Provider for Type Clustering
# Options: "google" (API-based, recommended) or "local" (sentence-transformers, requires PyTorch)
TYPE_EMBEDDING_PROVIDER=google
# Google Gemini API for embeddings (text-embedding-004, 768-dim, $0.0001/1K chars)
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_EMBEDDING_MODEL=text-embedding-004

# Type Expansion for Retrieval (Query Expansion)
TYPE_EXPANSION_ENABLED=true
TYPE_EXPANSION_SIMILARITY=0.80  # Minimum similarity for semantic neighbors
TYPE_EXPANSION_MAX_NEIGHBORS=10  # Maximum neighbors to include in query expansion

# Phase 6: Relationship Inference (User Story 4) - Session 12
# LLM-driven relationship discovery between memories (emergence over prescription)
RELATIONSHIP_INFERENCE_ENABLED=true
RELATIONSHIP_MIN_CONFIDENCE=0.7  # Minimum confidence threshold (0.0-1.0)
RELATIONSHIP_MODEL=  # Optional: Model for inference (defaults to EXTRACTION_MODEL or HAIA_MODEL)
RELATIONSHIP_MAX_PAIRS=10  # Max memory pairs to analyze per conversation (cost control)
RELATIONSHIP_TEMPORAL_CONFLICT_THRESHOLD=0.75  # Cosine similarity for temporal conflicts (0.0-1.0)

# Phase 8: Memory Consolidation Lifecycle (User Story 6) - Session 14
# Automatic memory lifecycle management: SHORT_TERM → LONG_TERM → ARCHIVED
# Prevents unbounded memory growth while preserving important memories
CONSOLIDATION_ENABLED=true
CONSOLIDATION_SCHEDULE=0 3 * * *  # Cron: Daily at 3 AM

# Tier Transition Thresholds
# Priority score formula: 0.40 * access_freq + 0.30 * recency + 0.30 * confidence
CONSOLIDATION_PROMOTION_THRESHOLD=0.7   # Score >= 0.7: SHORT_TERM → LONG_TERM
CONSOLIDATION_ARCHIVAL_THRESHOLD=0.2    # Score < 0.2: LONG_TERM → ARCHIVED

# Consolidation Rules
CONSOLIDATION_SHORT_TERM_DAYS=7  # Minimum days before SHORT_TERM can be promoted

# Decay Strategy Configuration
# Options: "exponential" (default, adaptive half-life), "ebbinghaus" (forgetting curve), "linear" (simple)
DECAY_STRATEGY=exponential
DECAY_BASE_HALF_LIFE_DAYS=43.3  # Base half-life for exponential decay (~6 weeks)
DECAY_BASE_STABILITY_DAYS=30.0  # Base stability for Ebbinghaus decay (only if DECAY_STRATEGY=ebbinghaus)
DECAY_MAX_DAYS=365.0            # Max days for linear decay (only if DECAY_STRATEGY=linear)

# Priority Score Weights (must sum to ~1.0)
# Controls how access patterns, recency, and confidence affect priority scoring
CONSOLIDATION_ACCESS_WEIGHT=0.40     # Weight for access frequency (normalized)
CONSOLIDATION_RECENCY_WEIGHT=0.30    # Weight for recency score (from decay strategy)
CONSOLIDATION_CONFIDENCE_WEIGHT=0.30 # Weight for extraction confidence

# Phase 9: Theme Discovery (User Story 7) - Session 14
# Automatic semantic theme discovery via DBSCAN clustering
# Discovers patterns and topics in memory corpus for better exploration
THEME_DISCOVERY_ENABLED=true
THEME_DISCOVERY_SCHEDULE=0 2 * * 0  # Cron: Weekly Sundays at 2 AM

# Theme Labeling Configuration
THEME_LABELING_MODEL=anthropic:claude-haiku-4-5-20251001  # Model for LLM theme labels

# DBSCAN Clustering Parameters
# Controls how memories are grouped into semantic clusters
DBSCAN_EPS=0.3              # Distance threshold for cluster membership (0.0-1.0, cosine distance)
DBSCAN_MIN_SAMPLES=3        # Minimum memories to form a dense region (cluster core)
MIN_THEME_CLUSTER_SIZE=3    # Minimum memories per theme (post-clustering filter)
MIN_SILHOUETTE_SCORE=0.5    # Minimum cluster quality score (-1 to 1, higher = better separation)

# =============================================================================
# Feature Flags - Session 10 (Hybrid Temporal Memory)
# =============================================================================
# Enable/disable major feature groups (Phase 2-Phase 9)
HYBRID_TEMPORAL_MEMORY=true  # Enables consolidation, theme discovery, and advanced retrieval features

# =============================================================================
# Web Search Integration - Session 15 (012-web-search)
# =============================================================================
# Multi-backend web search for current information, documentation, and troubleshooting
# Enables HAIA to access up-to-date information beyond training data cutoff

# Feature Toggle
SEARCH_ENABLED=true

# Backend API Keys
# Brave Search (recommended, paid) - $5 per 1000 queries
SEARCH_BRAVE_API_KEY=your_brave_api_key_here

# Tavily (AI-optimized, paid) - $1 per 1000 queries
SEARCH_TAVILY_API_KEY=your_tavily_api_key_here

# Google Custom Search Engine (expensive) - $5 per 1000 queries (100 free/day)
SEARCH_GOOGLE_CSE_API_KEY=your_google_api_key_here
SEARCH_GOOGLE_CSE_ENGINE_ID=your_search_engine_id_here

# Backend Priority (comma-separated, left = highest priority)
SEARCH_BACKEND_PRIORITY=brave,duckduckgo,tavily,google_cse

# Cache Configuration
SEARCH_CACHE_ENABLED=true
SEARCH_CACHE_TTL_SECONDS=86400  # 24 hours
# SEARCH_CACHE_REDIS_URL=redis://localhost:6379/0  # Optional Redis backend (defaults to in-memory)

# Cost Management
SEARCH_MONTHLY_BUDGET_USD=10.0
SEARCH_DAILY_BUDGET_USD=1.0
SEARCH_ALERT_THRESHOLD_PERCENT=80.0  # Alert at 80% of budget

# Rate Limiting
SEARCH_MAX_QUERIES_PER_MINUTE=30

# Result Processing
SEARCH_DEFAULT_MAX_RESULTS=10  # Fetch from backend
SEARCH_DEFAULT_TOP_RESULTS=5   # Present to user/LLM
SEARCH_MIN_RELEVANCE_SCORE=0.5 # Filter low-quality results

# Timeouts
SEARCH_REQUEST_TIMEOUT_SECONDS=10
